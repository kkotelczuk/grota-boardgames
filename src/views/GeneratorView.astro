---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeneratorApp from '@/components/vue/generator/GeneratorApp.vue';
import { localizedPath, useTranslations, type Locale } from '@/i18n';
import { buildGeneratorIndex, generatorLogoUrls } from '@/lib/data/generator';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const [games, logoUrls] = await Promise.all([buildGeneratorIndex(locale), generatorLogoUrls()]);
// Narzędzie dla części osób z Groty: noindex, poza sitemapą, bez linków w menu.
// Celowo NIE ma wpisu w robots.txt – publiczny `Disallow` zdradzałby adres.
const alternates = {
  pl: localizedPath({ name: 'generator' }, 'pl'),
  en: localizedPath({ name: 'generator' }, 'en'),
};
---

<BaseLayout
  title={`${t.meta.generatorTitle} – Grota`}
  description={t.meta.generatorDescription}
  locale={locale}
  alternates={alternates}
  current={null}
  noindex
>
  <section class="container-page pt-8 sm:pt-12">
    <h1 class="font-display text-4xl font-semibold sm:text-5xl">{t.generator.heading}</h1>
    <!--
      [Vue] client:only (a nie client:load): to, czy pokazać bramkę hasła, zależy od localStorage.
      Przy SSR serwer zawsze wyrenderowałby formularz hasła, który by mignął (albo dał mismatch).
      Strona nie potrzebuje treści w HTML – i tak jest noindex.
    -->
    <GeneratorApp client:only="vue" locale={locale} games={games} logoUrls={logoUrls} />
    <noscript>
      <p class="mt-6 text-muted">{t.generator.noscript}</p>
    </noscript>
  </section>
</BaseLayout>
